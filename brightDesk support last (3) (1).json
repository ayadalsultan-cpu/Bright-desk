    {
      "parameters": {
        "jsCode": "const PRICE_IN = 0.30 / 1e6;\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const start = $('Record Start').all()[i].json;\n  const err = items[i].json || {};\n  const userInput = String(start.userInput || '');\n  const inTok = Math.ceil(userInput.length / 4);\n  const errMsg = (err.error && (err.error.message || err.error.description)) || err.error || 'Agent execution failed';\n  out.push({ json: {\n    timestamp: new Date().toISOString(),\n    session_id: start.sessionId || '',\n    user_input: userInput,\n    agent_output: '',\n    latency_ms: Date.now() - Number(start.startedAt),\n    est_input_tokens: inTok,\n    est_output_tokens: 0,\n    est_cost_usd: Number((inTok * PRICE_IN).toFixed(6)),\n    quality_score: '',\n    success: false,\n    error: String(errMsg),\n  } });\n}\nreturn out;"
      },
