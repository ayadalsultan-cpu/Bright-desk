    {
      "parameters": {
        "jsCode": "// Estimated OpenRouter pricing for google/gemini-2.5-flash (USD per token)\nconst PRICE_IN = 0.30 / 1e6;\nconst PRICE_OUT = 2.50 / 1e6;\nconst out = [];\nconst items = $input.all();\n\nconst triggerData = $('When chat message received').first().json;\nconst agentData = $('AI Agent').first().json;\nconst endData = $('Mark End').first().json;\n\nconst startMs = new Date($execution.startTime).getTime();\nconst endMs = Number(endData.endedAt) || Date.now();\nconst latencyMs = endMs - startMs;\n\nconst userInput = String(triggerData.chatInput || '');\nconst agentOutput = String(agentData.output || '');\n\nfor (let i = 0; i < items.length; i++) {\n  const judgeText = String((items[i].json && items[i].json.text) || '');\n  const m = judgeText.match(/[1-5]/);\n  const quality = m ? Number(m[0]) : '';\n  \n  const inTok = Math.ceil(userInput.length / 4);\n  const outTok = Math.ceil(agentOutput.length / 4);\n  const cost = inTok * PRICE_IN + outTok * PRICE_OUT;\n\n  out.push({\n    json: {\n      timestamp: new Date().toISOString(),\n      session_id: triggerData.sessionId || '',\n      user_input: userInput,\n      agent_output: agentOutput,\n      latency_ms: latencyMs,\n      est_input_tokens: inTok,\n      est_output_tokens: outTok,\n      est_cost_usd: Number(cost.toFixed(6)),\n      quality_score: quality,\n      success: true,\n      error: '',\n    }\n  });\n}\nreturn out;"
      },
