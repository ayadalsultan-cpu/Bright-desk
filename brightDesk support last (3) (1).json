    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a strict QA evaluator for a customer-support assistant. Rate the quality of the ASSISTANT_ANSWER as a reply to the USER_QUESTION on an integer scale from 1 to 5, where 5 = accurate, complete and helpful, and 1 = incorrect, unhelpful or off-topic. Respond with ONLY the single integer, nothing else.\n\nUSER_QUESTION:\n{{ $('When chat message received').first().json.chatInput }}\n\nASSISTANT_ANSWER:\n{{ $('AI Agent').first().json.output }}",
        "batching": {}
      },
      "id": "08227d6e-3238-40ca-9d40-81af007ad337",
